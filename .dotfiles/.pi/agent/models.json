          "thinkingLevelMap": {
            "off": "none", "minimal": null, "low": "low",
            "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"
          }
        },
        {
          "id": "gpt-5.6-luna",
          "name": "GPT-5.6 Luna (Azure)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 922000,
          "maxTokens": 128000,
