          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 922000,
          "maxTokens": 128000,
          "cost": { "input": 5.0, "output": 30.0, "cacheRead": 0.5, "cacheWrite": 6.25 },
          "thinkingLevelMap": {
            "off": "none", "minimal": null, "low": "low",
            "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"
          }
        },
        {
          "id": "gpt-5.6-terra",
